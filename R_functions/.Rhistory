library(ggplot2)
library(lubridate)
library(xts)
library(patchwork)
library(Metrics)
load("R:/CARDAMOM_Outputs/ForwardRuns/AuchenMoss/DALEC32/C_cycle_2L.Rdata")
monthly_dates <- seq.Date(from = as.Date("2022-01-01"), to = as.Date("2023-12-31"), by = "day")
ET_s <- C_cycle_2L$Esoil_kgH2Om2day
ET_s <- ET_s[1,]
ET_t_f <- C_cycle_2L$Etrans_1st_root_layer_uptake_fraction
ET_t_f<- ET_t_f[1,]
ET_t_2f <- C_cycle_2L$Etrans_2nd_root_layer_uptake_fraction
ET_t_2f <- ET_t_2f[1,]
ET_t <- C_cycle_2L$Etrans_kgH2Om2day
ET_t  <- ET_t[1,]
ET <- C_cycle_2L$ET_kgH2Om2day
ET <- ET[1,]
ET_wet <- C_cycle_2L$Ewetcanopy_kgH2Om2day
ET_wet <- ET_wet[1,]
GPP <- C_cycle_2L$gpp_gCm2day
GPP <- GPP[1,]
gs <- C_cycle_2L$gs_mmolH2Om2s
gs <- gs[1,]
R <- C_cycle_2L$runoff_kgH2Om2day
R <- R[1,]
I_L1 <- C_cycle_2L$infiltrated_L1_kgH2Om2day
I_L1<-I_L1[1,]
I_L2 <- C_cycle_2L$infiltrated_L2_kgH2Om2day
I_L2 <- I_L2[1,]
df <- data.frame(ET_s,
ET_t )
time_series_plot_drainage <- ggplot(df, aes(x = date)) +
geom_line(aes(y = ET_s, color = "Layer 1"), size = 1) +
# geom_line(aes(y = Underflow, color = "Layer 2"), size = 1) +
labs(
x = expression(bold("Date")),
y = expression(bold("Es (kgH"[2]*"Om"^"-2" * "day"^"-1" *")")),
title = expression(bold("Soil Evaporation"))
) +
theme_bw() +
theme(
text = element_text(size = 25),
plot.title = element_text(size = 29, face = "bold"),
axis.title = element_text(size = 27, face = "bold"),
axis.text = element_text(size = 23),
axis.text.x = element_text(size = 25),
axis.text.y = element_text(size = 25)
) +
scale_color_manual(values = c(
"Layer 1" = "#4575b4",
"Layer 2" = "#d7191c"
))
print(time_series_plot_drainage)
